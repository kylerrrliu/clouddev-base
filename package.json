{
  "name": "clouddev-base",
  "version": "0.1.0",
  "description": "A slim MCP server that lets Claude (or any MCP host) open local projects, read/write/search code, and run shell commands.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "clouddev-base": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/webui','dist/webui',{recursive:true})\"",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
