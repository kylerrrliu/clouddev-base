{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash", "PowerShell", "Monitor", "Read", "Edit", "Write", "NotebookEdit", "Glob", "Grep", "LSP",
      "SendMessage", "ListAgents", "RemoteTrigger", "EnterWorktree", "ExitWorktree"
    ],
    "allow": [
      "mcp__clouddev-base__open_workspace",
      "mcp__clouddev-base__read",
      "mcp__clouddev-base__grep",
      "mcp__clouddev-base__glob"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "enabledMcpjsonServers": ["clouddev-base"],
  "crossSessionInbound": "refuse",
  "disableClaudeAiConnectors": true,
  "disableSkillShellExecution": true
}
